{
  "expo": {
    "name": "Zyphix",
    "slug": "zyphix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zyphix",
    "userInterfaceStyle": "light",
    "description": "The SuperLocal app: groceries in minutes, food from local kitchens and verified home services.",
    "ios": {
      "bundleIdentifier": "in.zyphix.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "CFBundleDisplayName": "Zyphix"
      }
    },
    "android": {
      "package": "in.zyphix.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0DA366",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05080E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
