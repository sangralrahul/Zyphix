{
  "name": "@workspace/zyphix",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:cf": "node scripts/build-cf.mjs",
    "cf:deploy": "pnpm run build:cf && wrangler --config wrangler.toml deploy",
    "cf:dev": "pnpm run build:cf && wrangler --config wrangler.toml dev",
    "catalog:export": "node scripts/catalog/export-mockdata.mjs",
    "db:schema": "wrangler d1 execute zyphix-catalog --remote --file=db/schema.sql",
    "db:seed": "wrangler d1 execute zyphix-catalog --remote --file=db/seed.sql",
    "images:sync": "node scripts/images/sync.mjs --base https://zyphix.in",
    "images:local": "node scripts/images/sync-local.mjs --base https://zyphix.in --reset failed",
    "images:thumbs": "node scripts/images/thumbs.mjs --base https://zyphix.in",
    "images:produce": "node scripts/images/sync.mjs --base https://zyphix.in --kind produce"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
